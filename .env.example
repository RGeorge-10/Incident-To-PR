# Copy to .env for local use. Never commit tokens or API keys.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/incident-to-pr.sqlite3
FRONTEND_ORIGIN=http://localhost:3000
# The dashboard proxies /api to this address (server-side); change it only if the API moves.
API_PROXY_TARGET=http://127.0.0.1:8000

# LLM diagnosis and proposal generation, routed through LiteLLM.
# LLM_MODEL is "<provider>/<model id>" exactly as LiteLLM expects it for your provider; LLM_API_KEY is that provider's key.
# Examples: openai/gpt-4.1-mini   or   anthropic/claude-haiku-5-5 (key from console.anthropic.com)
LLM_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=16000
# Leave empty for automatic (0, or omitted for Claude models, which reject sampling parameters).
LLM_TEMPERATURE=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_BASE=
LLM_TRACE_ENABLED=true

# Read-only Kubernetes and telemetry integrations
K8S_NAMESPACE=online-boutique
K8S_CONTEXT=incident-to-pr-observer
PROMETHEUS_URL=http://localhost:9090
# Optional extra evidence query. Replica, restart and container-state queries for the service are always collected.
PROMETHEUS_QUERY=up
PROMETHEUS_HEALTH_QUERY=kube_deployment_status_replicas_available{namespace="online-boutique",deployment="$service"}
VERIFICATION_WINDOW_MINUTES=15
VERIFICATION_MINIMUM_SAMPLES=20
# Automatic detection poll interval (minimum 15 s)
MONITOR_POLL_SECONDS=30
LOKI_URL=http://localhost:3100
LOKI_QUERY={namespace="online-boutique",pod=~"$service-.*"}
ALERTMANAGER_WEBHOOK_TOKEN=

# GitHub fine-grained token: contents read/write + pull requests read/write
# Keep it only in .env / a secret manager. The app creates branches and PRs, never merges.
GITHUB_TOKEN=
GITHUB_ARGOCD_READ_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_CODE_REPOSITORY=
GITHUB_GITOPS_REPOSITORY=
GITHUB_BASE_BRANCH=main
GITHUB_BOT_NAME=Incident-to-PR Bot
GITHUB_BOT_EMAIL=incident-to-pr[bot]@users.noreply.github.com
# `$service` expands to the incident's service name (only when it is a plain DNS label).
# CODE_CONTEXT_FILES is the fallback for services missing from SERVICE_CONTEXT_MAP.
CODE_ALLOWED_PATHS=src/$service/
INFRA_ALLOWED_PATHS=deploy/online-boutique/
CODE_CONTEXT_FILES=src/$service/main.go
# Per-service source files (takes precedence over CODE_CONTEXT_FILES). The shipped map covers Online Boutique v0.10.7.
SERVICE_CONTEXT_MAP=lab/service-context.json
INFRA_CONTEXT_FILES=deploy/online-boutique/$service.yaml
MAX_PATCH_FILES=3
MAX_PATCH_BYTES=200000

# GitOps observation only. Do not configure a token with ArgoCD sync/write privileges.
ARGOCD_URL=https://localhost:8081
ARGOCD_APPLICATION=online-boutique
ARGOCD_TOKEN=
ARGOCD_VERIFY_TLS=false

# Optional write endpoint for a separately hosted, trusted hidden-test evaluator.
# The app itself never stores hidden regression tests or ground-truth labels.
EVALUATOR_URL=
EVALUATOR_TOKEN=

# Safety controls
REQUIRE_HUMAN_APPROVAL=true
MAX_OPEN_INCIDENTS=20
# A proposal cannot be approved once its evidence is older than this; re-run the analysis instead.
EVIDENCE_MAX_AGE_SECONDS=1800
AUTO_APPLY_ENABLED=false
